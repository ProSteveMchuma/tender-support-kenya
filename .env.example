# Copy to .env.local for local development. Never commit real values.
# All of these are server-only (no NEXT_PUBLIC_ prefix) unless stated.

# Durable lead destination. The endpoint must store the lead and reply
# {"ok": true, "reference": "<the reference it was sent>"}. See docs/lead-webhook.gs.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Optional staff notification email via Resend (failure is logged; the lead is kept).
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
LEAD_NOTIFY_FROM=

# Optional, cookieless analytics. Only loads once the site is production-ready.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Local testing only: allow an http://localhost webhook (see npm run mock-webhook).
LEAD_WEBHOOK_ALLOW_LOCALHOST=
